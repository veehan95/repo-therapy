{
  "name": "repo-therapy",
  "version": "0.24.003",
  "description": "A lightweight framework that smartly reads and validates project environment variables.",
  "type": "module",
  "main": "bin/src/main.js",
  "types": "bin/src/index.d.ts",
  "bin": {
    "repo-therapy": "bin/src/main.js",
    "rt": "bin/src/main.js"
  },
  "exports": {
    ".": {
      "types": "./bin/src/index.d.ts",
      "default": "./bin/src/index.js"
    }
  },
  "files": [
    "bin/src",
    "bin/generated",
    "bin/scripts",
    "bin/config"
  ],
  "scripts": {
    "build": "rm -rf bin && yarn tsx ./src/main.ts prepare && tsc",
    "prepare": "husky",
    "lint": "eslint .",
    "prepack": "git push && yarn build",
    "start": "tsx ./src/main.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "tsx": "^4.23.12",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/yargs": "^17.0.35",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
